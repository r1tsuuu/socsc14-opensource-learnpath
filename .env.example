# Copy to .env and fill in. Never commit .env.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Leave blank locally to use SQLite. Production: the Neon connection string.
DATABASE_URL=

# Google login (Google Cloud console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
